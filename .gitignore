# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Python development helpers
__pycache__/
*.pyc

# Local credentials, backup payloads and generated release/test evidence.
# Keep reviewed SQL, tests, tools and Markdown reports versionable.
*.private.*
*.dump
*.sql.gz
*.bundle
/test-results/
/playwright-report/
/.next-*/
/server-data/public-english/
server-data/reviewed-news/
/private/pc-restore-kit/

# Private operator material and local environments
/private/
/reports/
/docs/handoff/
*.oazbak
*.dpapi
*.docx
*.zip
!.env.example

# Private event photograph supplied separately by the association.
/public/oaz_homecomming.jpg
